# Copy this file to .env.production on the VPS and fill real values.

# Public URL of the deployed site, used for metadata and canonical social previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key

# Host port mapped to the container's internal 3000 port.
APP_PORT=3000
